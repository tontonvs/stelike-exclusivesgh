# Copy this file to .env and fill in your real Paystack TEST keys.
# Get them from: Paystack Dashboard -> Settings -> API Keys & Webhooks (Test mode)

# Public key — safe to expose in the browser. Must be prefixed with VITE_
# so Vite includes it in the client bundle.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Secret key — server-side only. NEVER prefix with VITE_ or it will be
# shipped to the browser. Used only in src/lib/paystack.ts to verify
# transactions after payment.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
